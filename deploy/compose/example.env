# Settings for compose.yaml. Copy this file to .env next to it and replace every <...>. Keep .env
# private: it holds the secrets. No quotes and no comments after a value. What each app setting
# means: guide/hosting.md#settings.

# The image version to run (a release, never latest), and the port on this machine that your https
# proxy forwards to.
SIMPLEARCHITECTURE_VERSION=<version, for example 1.2.3>
APP_PORT=<port, for example 8080>

# The domain only, as your https proxy serves it: the app is at https://<APP_DOMAIN>, and its
# sign-in callback at https://<APP_DOMAIN>/auth/callback.
APP_DOMAIN=<architecture.example.com>

# The database password, for PostgreSQL and the app. Letters and digits only, as it goes into a
# URL: openssl rand -hex 32
POSTGRES_PASSWORD=<random letters and digits>

# Your own OpenID Connect provider (see guide/sign-in.md).
OIDC_ISSUER=<https://the provider's issuer, exactly as it names itself>
OIDC_CLIENT_ID=<client id>
OIDC_CLIENT_SECRET=<client secret>

# At least 32 random characters, not the client secret: openssl rand -base64 48
SESSION_SECRET=<random value>

# The ID token claim that holds the roles, and the value in it for each role.
OIDC_ROLES_CLAIM=<claim name, for example roles>
OIDC_ROLE_ADMIN=<value that gives Admin>
OIDC_ROLE_MODELLER=<value that gives Modeller>
OIDC_ROLE_VIEWER=<value that gives Viewer>
