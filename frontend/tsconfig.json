{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    // Use the shared package's source directly (live types, no prebuild). Vite reads this via resolve.tsconfigPaths.
    "paths": {
      "@simplearchitecture/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite", "vite.config.ts"]
}
