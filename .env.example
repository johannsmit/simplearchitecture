# Development only. Copy to .env (git-ignored, chmod 600) and fill in. Never commit real secrets.
# The API and the web dev server read exactly these twelve settings, all required, and refuse to
# start if one is missing or invalid. Any other setting is ignored, with a warning, except the
# optional ones shown commented out below, which a standard setup leaves out.
# The hosted image reads the same, without the two ports: see the README, "Hosting the image".

# The domain only (no http://, port or path). In development the app runs over plain http, which
# providers allow for localhost only, so keep localhost. The web app is at
# http://<APP_DOMAIN>:<FRONTEND_PORT> and proxies /api and /auth to the API. The provider sends the
# sign-in back to http://<APP_DOMAIN>:<BACKEND_PORT>/auth/callback: register exactly that.
APP_DOMAIN=localhost
FRONTEND_PORT=5173
BACKEND_PORT=3000

# PostgreSQL (see the README, "Database"). Secret: it holds the database password, percent-encoded.
# Any host other than localhost or 127.0.0.1 always uses TLS with a certificate from a public
# certificate authority.
DATABASE_URL=postgres://simplearchitecture:<password>@localhost:5432/simplearchitecture
# Optional: `entra` signs in to Azure Database for PostgreSQL with the workload identity's token
# instead of a password (README, "Database sign-in with Microsoft Entra instead of a password"). Then
# DATABASE_URL has no password, and Azure Workload Identity sets AZURE_CLIENT_ID, AZURE_TENANT_ID and
# AZURE_FEDERATED_TOKEN_FILE.
# DATABASE_AUTH=entra

# Sign-in (OpenID Connect). The issuer is the provider's full https address, exactly as the provider
# names it (a trailing slash counts). See the README, "Using another provider".
# Entra ID: https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_ISSUER=
# The client id. Entra ID: the Application (client) ID on the app registration's Overview page.
OIDC_CLIENT_ID=
# Secret: the client secret. Entra ID: a value from Certificates & secrets.
OIDC_CLIENT_SECRET=
# Optional: `federated` signs in with the platform's token instead of the client secret, which is
# then not read (README, "Federated credential instead of a client secret"). Azure Workload
# Identity sets AZURE_FEDERATED_TOKEN_FILE on the pod.
# OIDC_CLIENT_AUTH=federated
# AZURE_FEDERATED_TOKEN_FILE=
# Secret: at least 32 random characters, e.g. the output of `openssl rand -base64 48`.
SESSION_SECRET=

# The ID token claim holding the roles (one top-level claim, a list or a single text), and the
# values in it that give each role. Entra ID: `roles`, and the app role values on your app
# registration (App roles > Value). Matched exactly, case-sensitive, and all three must differ.
OIDC_ROLES_CLAIM=roles
OIDC_ROLE_ADMIN=Admin
OIDC_ROLE_MODELLER=Modeller
OIDC_ROLE_VIEWER=Viewer
